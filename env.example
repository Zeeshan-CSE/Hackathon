# Port the server listens on (most hosts set this for you)
PORT=3000
# Use PostgreSQL in production. Leave empty to use a local SQLite file instead.
DATABASE_URL=
# Set to true if your Postgres host requires SSL and the URL has no sslmode
PGSSL=false
# SQLite folder (mount a persistent disk/volume here if you use SQLite)
DATA_DIR=./data
# Number of reverse proxies in front of the app (1 on Render/Railway/Fly/Heroku)
TRUST_PROXY=1
# Optional rate limits per IP per 15 minutes
READ_LIMIT=4000
WRITE_LIMIT=1000
